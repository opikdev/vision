{
  "name": "vision",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @vision/desktop dev",
    "build": "pnpm -r build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "pnpm --filter @vision/desktop test:e2e",
    "bench": "pnpm --filter @vision/desktop bench",
    "replay": "node --import ./apps/desktop/bench/resolve-ts.mts apps/desktop/bench/replay.ts",
    "replay:record": "node --import ./apps/desktop/bench/resolve-ts.mts apps/desktop/bench/record.ts",
    "eval:design": "node evals/design/run.ts",
    "package": "pnpm --filter @vision/desktop package"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "9.1.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0"
  }
}
