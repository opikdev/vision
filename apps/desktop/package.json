{
  "name": "@vision/desktop",
  "productName": "Vision",
  "version": "0.1.0",
  "private": true,
  "description": "See .vis designs redraw live while an AI builds them",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc -p tsconfig.node.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "test:e2e": "electron-vite build && playwright test",
    "package": "pnpm --filter @vision/mcp build && electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "chokidar": "5.0.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vision/format": "workspace:*",
    "@vitejs/plugin-react": "6.2.1",
    "electron": "45.2.2",
    "electron-builder": "26.18.1",
    "electron-vite": "6.0.0",
    "happy-dom": "21.0.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.4",
    "vite": "8.3.5",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  }
}
